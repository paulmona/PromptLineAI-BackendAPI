{% extends "layouts/base.njk" %}

{% block title %}Devices - PromptLineAI Dashboard{% endblock %}

{% block pageTitle %}PromptLineAI - Devices{% endblock %}

{% block headerRight %}
<a id="back-to-dashboard" href="#" class="retry-btn" style="text-decoration:none; width:auto;">Back to Dashboard</a>
{% endblock %}

{% block content %}
<div class="container">
  <div id="auth-banner" class="error-banner hidden">
    <span id="auth-message"></span>
    <a id="auth-sign-in-link" class="retry-btn" href="#" style="text-decoration:none;">Sign in</a>
  </div>

  <div id="error-banner" class="error-banner hidden">
    <span id="error-message"></span>
    <button id="retry-btn" class="retry-btn">Retry</button>
  </div>

  <div id="devices-content">
    <section class="chart-section">
      <h2>All Devices</h2>
      <div class="table-container-full">
        <table id="devices-table">
          <thead>
            <tr>
              <th>Device Name</th>
              <th>Last Seen</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <tr><td colspan="3">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/env.js"></script>
<script src="/assets/auth.js"></script>
<script src="/assets/nav.js"></script>
<script src="/assets/devices.js"></script>
{% endblock %}
