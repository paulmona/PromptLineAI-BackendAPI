{% extends "layouts/base.njk" %}

{% block title %}Sign In - PromptLineAI{% endblock %}

{% block content %}
<div class="login-container">
  <div class="login-card">
    <div id="status" class="status" style="display: none;"></div>
    <div id="error" class="error" style="display: none;"></div>
    
    <div id="sign-in-container"></div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/env.js"></script>
<script src="/assets/auth.js"></script>
<script>
  (async () => {
    const statusEl = document.getElementById('status');
    const errorEl = document.getElementById('error');
    const signInContainer = document.getElementById('sign-in-container');
    
    try {
      if (!window.PromptLineAuth || !window.PromptLineAuth.initClerk) {
        errorEl.textContent = 'Authentication not available. Please refresh the page.';
        errorEl.style.display = 'block';
        return;
      }

      await window.PromptLineAuth.initClerk();
      
      // Check if user is already signed in
      if (!window.Clerk || !window.Clerk.loaded) {
        errorEl.textContent = 'Clerk not loaded. Please refresh the page.';
        errorEl.style.display = 'block';
        return;
      }

      const session = await window.Clerk.session;
      if (session) {
        // User is already signed in - check org and redirect
        const token = await session.getToken();
        if (token) {
          const user = await window.Clerk.user;
          const orgMemberships = user?.organizationMemberships || [];
          
          if (orgMemberships.length > 0) {
            // User has org - redirect to dashboard
            const res = await fetch('/me', {
              headers: { Authorization: `Bearer ${token}` }
            });
            
            if (res.ok) {
              const me = await res.json();
              const slug = me?.org?.slug;
              if (slug) {
                window.location.href = `/${encodeURIComponent(slug)}`;
                return;
              }
            }
          }
          // User signed in but no org or /me failed - show sign-in form anyway
        }
      }
      
      // User is not signed in or needs to sign in again - mount sign-in component
      statusEl.textContent = '';
      statusEl.style.display = 'none';
      
      window.PromptLineAuth.mountSignIn(signInContainer, {
        fallbackRedirectUrl: window.location.origin + '/',
      });
      
    } catch (e) {
      console.error('Login page error:', e);
      errorEl.textContent = 'Unable to initialize sign-in. Please refresh the page.';
      errorEl.style.display = 'block';
    }
  })();
</script>
{% endblock %}
