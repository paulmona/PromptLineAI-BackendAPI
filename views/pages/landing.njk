{% extends "layouts/base.njk" %}

{% block title %}PromptLineAI - AI Compliance Made Simple{% endblock %}

{% block content %}
<!-- Hero Section -->
<section class="hero">
  <div class="container">
    <h1 class="hero-title">AI Compliance Made Simple</h1>
    <p class="hero-subtitle">Monitor, track, and ensure compliance across all your AI tool usage. Get complete visibility into ChatGPT, Google Gemini, and other LLM interactions.</p>
    <div class="hero-actions">
      <a href="/pricing" class="btn btn-primary">Get Started</a>
      <a href="/pricing" class="btn btn-secondary">View Pricing</a>
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="features" id="product">
  <div class="container">
    <h2 class="section-title">Why PromptLineAI?</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">📊</div>
        <h3>Complete Visibility</h3>
        <p>Track every AI interaction across your organization. See which tools are being used, when, and by whom.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🔒</div>
        <h3>Compliance Monitoring</h3>
        <p>Ensure your organization meets AI compliance requirements. Monitor file uploads and sensitive data handling.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📈</div>
        <h3>Real-time Analytics</h3>
        <p>Get insights into AI usage patterns with comprehensive dashboards and reporting tools.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚙️</div>
        <h3>Easy Integration</h3>
        <p>Simple Chrome extension installation. No complex setup required. Start monitoring in minutes.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
  <div class="container">
    <h2>Ready to get started?</h2>
    <p>Choose a plan that fits your organization's needs.</p>
    <a href="/pricing" class="btn btn-primary">View Pricing</a>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script src="/env.js"></script>
<script src="/assets/auth.js"></script>
<script>
  (async () => {
    // Check if user is authenticated and redirect to dashboard if so
    try {
      if (!window.PromptLineAuth || !window.PromptLineAuth.initClerk) {
        // Auth not available, show marketing page
        return;
      }

      await window.PromptLineAuth.initClerk();
      
      // Check if user is already signed in
      if (!window.Clerk || !window.Clerk.loaded) {
        // Clerk not loaded, show marketing page
        return;
      }

      const session = await window.Clerk.session;
      if (!session) {
        // User is not signed in, show marketing page
        return;
      }

      const token = await session.getToken();
      if (!token) {
        // No token available, show marketing page
        return;
      }

      // Check if user has organization memberships using Clerk.js
      const user = await window.Clerk.user;
      if (!user) {
        // No user object, show marketing page
        return;
      }

      // Get user's organization memberships
      const orgMemberships = user.organizationMemberships || [];
      const orgCount = orgMemberships.length;

      if (orgCount === 0) {
        // User is authenticated but has no org memberships
        // Show marketing page (they need to be added to an org first)
        console.log('User authenticated but has no organization memberships');
        return;
      }

      if (orgCount > 1) {
        // User has multiple orgs - this shouldn't happen but handle gracefully
        console.warn(`User has ${orgCount} org memberships, using first one`);
      }

      // User has at least one org - call /me to get org slug and redirect
      const res = await fetch('/me', {
        headers: { Authorization: `Bearer ${token}` }
      });

      if (res.ok) {
        const me = await res.json();
        const slug = me?.org?.slug;
        if (slug) {
          // Redirect to user's dashboard
          window.location.href = `/${encodeURIComponent(slug)}`;
          return;
        }
      }

      // If /me fails (403, 500, etc.), show marketing page
      if (res.status === 403) {
        console.log('User authenticated but organization not provisioned');
      } else {
        console.error('Failed to get user info:', res.status);
      }
      
      // Show marketing page (current behavior)
    } catch (e) {
      // Error checking auth - show marketing page anyway
      console.error('Auth check error:', e);
    }

    // Mobile hamburger menu for public pages
    (function() {
      const hamburgerBtn = document.getElementById('public-hamburger-btn');
      const navWrapper = document.getElementById('public-nav-wrapper');
      
      if (hamburgerBtn && navWrapper) {
        hamburgerBtn.addEventListener('click', function() {
          navWrapper.classList.toggle('menu-open');
          hamburgerBtn.classList.toggle('active');
        });
        
        // Close menu when clicking outside
        document.addEventListener('click', function(event) {
          if (!hamburgerBtn.contains(event.target) && !navWrapper.contains(event.target)) {
            navWrapper.classList.remove('menu-open');
            hamburgerBtn.classList.remove('active');
          }
        });
      }
    })();
  })();
</script>
{% endblock %}
