<header class="main-header">
  <div class="header-top">
    <div class="header-left">
      {% if orgSlug %}
      <button id="hamburger-btn" class="hamburger-btn" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      {% endif %}
      <h1 class="header-brand">{% block pageTitle %}PromptLineAI{% endblock %}</h1>
    </div>
    <div class="header-right">
      {% block headerRight %}{% endblock %}
      {% if showUserControls %}
      <span id="org-pill" style="font-size:12px; color:#555;"></span>
      {% endif %}
    </div>
  </div>
  
  {% if orgSlug %}
  <div class="header-nav-wrapper">
    {% include "partials/nav.njk" %}
  </div>
  {% endif %}
  
  {% if showRangeSelector %}
  <div class="range-selector">
    <label for="range-select" style="margin-right: 8px; font-size: 0.9rem; color: #555;">Time Range:</label>
    <select id="range-select" class="range-select">
      <option value="24h" selected>Last 24 Hours</option>
      <option value="7d">Last 7 Days</option>
      <option value="30d">Last 30 Days</option>
    </select>
  </div>
  {% endif %}
</header>
