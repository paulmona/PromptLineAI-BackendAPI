<header class="main-header">
  <div class="header-top">
    <div class="header-left">
      {% if orgSlug %}
      <button id="hamburger-btn" class="hamburger-btn" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      {% else %}
      {# Public pages: Show hamburger for mobile #}
      <button id="public-hamburger-btn" class="hamburger-btn" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      {% endif %}
      {% if orgSlug %}
      <h1 class="header-brand">{% block pageTitle %}PromptLineAI{% endblock %}</h1>
      {% else %}
      <h1 class="header-brand"><a href="/" style="text-decoration: none; color: inherit;">{% block pageTitlePublic %}PromptLineAI{% endblock %}</a></h1>
      {% endif %}
    </div>
    <div class="header-right">
      {% if orgSlug %}
        {# Authenticated: Show existing controls #}
        {% block headerRight %}{% endblock %}
        {% if showUserControls %}
        <span id="org-pill" style="font-size:12px; color:#555;"></span>
        {% endif %}
      {% else %}
        {# Public: Show public navigation #}
        <nav class="public-nav">
          <ul class="public-nav-links">
            <li><a href="/#product">Product</a></li>
            <li><a href="/pricing">Pricing</a></li>
            <li><a href="/login" class="btn-login">Login</a></li>
          </ul>
        </nav>
      {% endif %}
    </div>
  </div>

  {% if orgSlug %}
  <!-- Desktop Navigation Bar -->
  <nav class="admin-nav-desktop">
    {% if not isPlatformAdmin %}
    <ul class="admin-nav-list">
      <!-- Dashboard Dropdown -->
      <li class="admin-nav-item">
        <div class="admin-dropdown">
          <button class="admin-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
            Dashboard
          </button>
          <ul class="admin-dropdown-menu">
            <li><a href="/{{ orgSlug }}/users">Users</a></li>
          </ul>
        </div>
      </li>

      <!-- Settings Dropdown -->
      <li class="admin-nav-item admin-settings-dropdown" id="admin-desktop-settings">
        <div class="admin-dropdown">
          <button class="admin-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
            Settings
          </button>
          <ul class="admin-dropdown-menu">
            <li><a href="#" id="desktop-account-link">Account</a></li>
            <li><a href="#" id="desktop-org-profile-link">Org Profile</a></li>
            <li><a href="/{{ orgSlug }}/policy" id="desktop-policy-link">Policy</a></li>
          </ul>
        </div>
      </li>
    </ul>
    {% endif %}

    <!-- Logout Button -->
    <button class="admin-nav-logout" id="desktop-logout-btn">Logout</button>
  </nav>
  {% endif %}

  {% if orgSlug %}
  <div class="header-nav-wrapper">
    {% include "partials/nav.njk" %}
  </div>
  {% else %}
  {# Public pages: Mobile navigation menu #}
  <div id="public-nav-wrapper" class="header-nav-wrapper">
    <nav class="public-nav-mobile">
      <ul class="public-nav-links-mobile">
        <li><a href="/#product">Product</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/login" class="btn-login">Login</a></li>
      </ul>
    </nav>
  </div>
  {% endif %}
  
  {% if showRangeSelector %}
  <div class="range-selector">
    <label for="range-select" style="margin-right: 8px; font-size: 0.9rem; color: #555;">Time Range:</label>
    <select id="range-select" class="range-select">
      <option value="24h" selected>Last 24 Hours</option>
      <option value="7d">Last 7 Days</option>
      <option value="30d">Last 30 Days</option>
    </select>
  </div>
  {% endif %}
</header>
