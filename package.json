{
  "name": "promptlineai-backend-api",
  "version": "0.1.0",
  "description": "PromptLineAI backend API - local-first POC",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "vitest related --run"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/backend": "^1.32.0",
    "@fastify/static": "^9.0.0",
    "@fastify/view": "^11.1.1",
    "dotenv": "^16.4.1",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.8.1",
    "nunjucks": "^3.2.4",
    "pg": "^8.18.0",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.31",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.10.9",
    "@vitest/coverage-v8": "^4.0.18",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  }
}
