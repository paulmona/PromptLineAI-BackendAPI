# Server
PORT=8787

# Clerk (dashboard auth)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional: hosted pages sign-in/up URLs (only needed if using Clerk Hosted Pages)
# The app uses embedded Clerk components by default (no hosted pages required)
# If you want to use Hosted Pages instead, uncomment and configure these:
# CLERK_SIGN_IN_URL=https://your-app.clerk.accounts.dev/sign-in?redirect_url=http://127.0.0.1:8787/
# CLERK_SIGN_UP_URL=https://your-app.clerk.accounts.dev/sign-up?redirect_url=http://127.0.0.1:8787/

# Optional: Frontend API URL (FAPI) for Clerk.js script loading
# If not provided, will be automatically extracted from CLERK_SIGN_IN_URL
# Format: https://your-app.clerk.accounts.dev
# Default (if unset): Extracted from CLERK_SIGN_IN_URL
CLERK_FAPI_URL=https://your-app.clerk.accounts.dev

# Optional: override where Clerk.js is loaded from (for restricted DNS environments)
# Default (if unset): Built from CLERK_FAPI_URL as https://${CLERK_FAPI_URL}/npm/@clerk/clerk-js@5/dist/clerk.browser.js
CLERK_JS_URL=https://your-app.clerk.accounts.dev/npm/@clerk/clerk-js@5/dist/clerk.browser.js

# Ingest key hashing pepper (HMAC). Treat as immutable for the POC.
# Generate: openssl rand -hex 32
INGEST_KEY_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Platform Admin (Clerk org ID for platform administrators)
PLATFORM_ADMIN_CLERK_ORG_ID=org_xxxxxxxxxxxxx

# Postgres (discrete fields)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aicompliance
DB_USER=promptline
DB_PASSWORD=your-password

# Optional override
# DATABASE_URL=postgres://promptline:your-password@127.0.0.1:5432/aicompliance

