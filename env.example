# Server
PORT=8787

# Clerk (dashboard auth)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional: hosted pages sign-in/up URLs (used by landing/dashboard sign-in links)
CLERK_SIGN_IN_URL=https://your-app.clerk.accounts.dev/sign-in?redirect_url=http://127.0.0.1:8787/
CLERK_SIGN_UP_URL=https://your-app.clerk.accounts.dev/sign-up?redirect_url=http://127.0.0.1:8787/

# Ingest key hashing pepper (HMAC). Treat as immutable for the POC.
# Generate: openssl rand -hex 32
INGEST_KEY_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Postgres (discrete fields)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aicompliance
DB_USER=promptline
DB_PASSWORD=your-password

# Optional override
# DATABASE_URL=postgres://promptline:your-password@127.0.0.1:5432/aicompliance

